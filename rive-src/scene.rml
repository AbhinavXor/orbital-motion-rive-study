          colorValue="FFF6F4ED"
          name="CoreColor"
        />
      </Fill>
    </Shape>



    <!-- =================================================
         STATE MACHINE
         ================================================= -->

    <StateMachine
      name="Main"
      id="0:100"
    >

      <StateMachineNumber
        name="pointerX"
        value="0"
        id="0:101"
      />

      <StateMachineNumber
        name="pointerY"
        value="0"
        id="0:102"
      />

      <StateMachineNumber
        name="scroll"
        value="0"
        id="0:103"
      />

      <StateMachineBool
        name="focus"
        value="false"
        id="0:104"
      />

      <StateMachineTrigger
        name="burst"
        id="0:105"
      />

      <StateMachineBool
        name="reducedMotion"
        value="false"
        id="0:106"
      />


      <!-- =============================================
           POINTER X
           -1 = pointer left
            0 = center
            1 = pointer right
           ============================================= -->

      <StateMachineLayer
        name="Pointer X"
        id="0:120"
      >

        <AnyState
          x="100"
          y="-120"
        />

        <ExitState
          x="520"
          y="-120"
        />

        <EntryState
          x="0"
          y="0"
        >
          <StateTransition
            stateToId="0:121"
          />
        </EntryState>

        <BlendState1DInput
          inputId="0:101"
          x="260"
          y="0"
          id="0:121"
        >

          <BlendAnimation1D
            animationId="0:210"
            value="-1"
          />

          <BlendAnimation1D
            animationId="0:211"
            value="0"
          />

          <BlendAnimation1D
            animationId="0:212"
            value="1"
          />

        </BlendState1DInput>

      </StateMachineLayer>


      <!-- =============================================
           POINTER Y
           ============================================= -->

      <StateMachineLayer
        name="Pointer Y"
        id="0:130"
      >

        <AnyState
          x="100"
          y="-120"
        />

        <ExitState
          x="520"
          y="-120"
        />

        <EntryState
          x="0"
          y="0"
        >
          <StateTransition
            stateToId="0:131"
          />
        </EntryState>

        <BlendState1DInput
          inputId="0:102"
          x="260"
          y="0"
          id="0:131"
        >

          <BlendAnimation1D
            animationId="0:220"
            value="-1"
          />

          <BlendAnimation1D
            animationId="0:221"
            value="0"
          />

          <BlendAnimation1D
            animationId="0:222"
            value="1"
          />

        </BlendState1DInput>

      </StateMachineLayer>


      <!-- =============================================
           SCROLL
           0   = assembled
           .5  = maximum separation
           1   = reassembled
           ============================================= -->

      <StateMachineLayer
        name="Scroll"
        id="0:140"
      >

        <AnyState
          x="100"
          y="-120"
        />

        <ExitState
          x="520"
          y="-120"
        />

        <EntryState
          x="0"
          y="0"
        >
          <StateTransition
            stateToId="0:141"
          />
        </EntryState>

        <BlendState1DInput
          inputId="0:103"
          x="260"
          y="0"
          id="0:141"
        >

          <BlendAnimation1D
            animationId="0:230"
            value="0"
          />

          <BlendAnimation1D
            animationId="0:231"
            value="0.5"
          />

          <BlendAnimation1D
            animationId="0:232"
            value="1"
          />

        </BlendState1DInput>

      </StateMachineLayer>

    </StateMachine>



    <!-- =================================================
