<Rive version="1" kind="fragment">

  <Artboard
    width="900"
    height="900"
    name="OrbitalCore"
    defaultStateMachineId="0:100"
    id="0:1"
   styleId="0:2">

    <LayoutComponentStyle
      id="0:2"
      name="ArtboardStyle"
    />


    <!-- Warm neutral background -->
    <Fill name="Background">
      <SolidColor
        colorValue="FFF1EFE9"
        name="BackgroundColor"
      />
    </Fill>


    <!-- =================================================
         REAR GEOMETRY
         ================================================= -->

    <Shape
      x="450"
      y="450"
      rotation="-0.35"
      name="RearShardA"
      id="0:10"
    >
      <Triangle
        originX="0.5"
        originY="0.5"
        width="490"
        height="470"
        name="RearPathA"
      />

      <Fill name="RearFillA">
        <SolidColor
          colorValue="FFCAC7BD"
          name="RearColorA"
        />
      </Fill>
    </Shape>


    <Shape
      x="450"
      y="450"
      rotation="0.55"
      name="RearShardB"
      id="0:11"
    >
